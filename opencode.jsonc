{
  "$schema": "https:opencode.ai/config.json",
  "instructions": [],
  "formatter": {
    "java-spotless": {
      "command": ["mvn", "spotless:apply", "-DspotlessFiles=$FILE"],
      "extensions": [".java"]
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GHPAT}"
      }
    }
  }
}